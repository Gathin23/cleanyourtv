<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CleanYourTV — Mobile, Tablet &amp; TV Edition"
            android:textColor="#FFFFFF"
            android:textSize="24sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etTvIp"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="2"
                android:hint="TV IP (e.g. 127.0.0.1 or 192.168.1.50)"
                android:text="127.0.0.1"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="#222222"
                android:padding="8dp"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etTvPort"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1"
                android:hint="Port"
                android:text="5555"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="#222222"
                android:padding="8dp"
                android:textSize="14sp"
                android:inputType="number"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="0dp"
                android:layout_height="50dp"
                android:layout_weight="1.2"
                android:text="Connect"
                android:backgroundTint="#0288D1"
                android:textColor="#FFFFFF" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvDeviceInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Detecting Device &amp; Local ADB..."
            android:textColor="#BBBBBB"
            android:textSize="14sp"
            android:layout_marginBottom="12dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="10dp">

            <Button
                android:id="@+id/btnScan"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="1. Scan TV Apps"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#1E88E5"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDisable"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="2. Debloat TV"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#E53935"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnFastBoot"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="3. Accelerate Boot &amp; OS"
                android:layout_marginStart="4dp"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#FB8C00"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnRestore"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="4. Restore TV"
                android:layout_marginStart="4dp"
                android:backgroundTint="#43A047"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvAdbHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Mobile/Tablet Mode: Connect phone/tablet to the same Wi-Fi as your TV. Enable 'Wireless Debugging' in TV Developer Options, enter TV IP above, and tap Connect to debloat and optimize OS remotely."
            android:textColor="#FFB74D"
            android:textSize="12sp"
            android:padding="8dp"
            android:background="#263238"
            android:layout_marginBottom="10dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:text="Ready. Connect to TV or tap '1. Scan TV Apps'."
            android:textColor="#E0E0E0"
            android:textSize="13sp"
            android:scrollbars="vertical"
            android:background="#1E1E1E"
            android:padding="10dp" />

    </LinearLayout>
</ScrollView>
