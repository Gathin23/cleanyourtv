<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="#121212"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CleanYourTV — TV Edition"
        android:textColor="#FFFFFF"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/tvDeviceInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Detecting TV Hardware &amp; Local ADB..."
        android:textColor="#BBBBBB"
        android:textSize="16sp"
        android:layout_marginBottom="16dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp">

        <Button
            android:id="@+id/btnScan"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="1. Scan Apps"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#1E88E5"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnDisable"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="2. Disable Safe Candidates"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#E53935"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnRestore"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="3. Restore Disabled Apps"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginStart="6dp"
            android:layout_marginEnd="6dp"
            android:backgroundTint="#43A047"
            android:textColor="#FFFFFF" />

        <Button
            android:id="@+id/btnExport"
            android:layout_width="0dp"
            android:layout_height="60dp"
            android:layout_weight="1"
            android:text="4. Export Report"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:layout_marginStart="6dp"
            android:backgroundTint="#757575"
            android:textColor="#FFFFFF" />
    </LinearLayout>

    <TextView
        android:id="@+id/tvAdbHelp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Standalone Mode: Disabling requires local Wireless Debugging on the TV (Settings -> Developer Options -> Wireless Debugging). If not active, CleanYourTV records baseline &amp; displays required ADB commands for execution."
        android:textColor="#FFB74D"
        android:textSize="13sp"
        android:padding="8dp"
        android:background="#263238"
        android:layout_marginBottom="12dp"/>

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:text="Ready. Select '1. Scan Apps' to inspect packages."
        android:textColor="#E0E0E0"
        android:textSize="14sp"
        android:scrollbars="vertical"
        android:background="#1E1E1E"
        android:padding="12dp" />

</LinearLayout>
