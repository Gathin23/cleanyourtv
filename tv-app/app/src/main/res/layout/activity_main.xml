<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#121212"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/tvTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="CleanYourTV — Control Center"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <!-- Target Connection Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <EditText
                android:id="@+id/etTvIp"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="2"
                android:hint="TV IP (e.g. 192.168.1.50)"
                android:text="127.0.0.1"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="#222222"
                android:padding="12dp"
                android:textSize="14sp"
                android:layout_marginEnd="6dp" />

            <EditText
                android:id="@+id/etTvPort"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1"
                android:hint="Port"
                android:text="5555"
                android:textColor="#FFFFFF"
                android:textColorHint="#888888"
                android:background="#222222"
                android:padding="12dp"
                android:textSize="14sp"
                android:inputType="number"
                android:layout_marginEnd="6dp" />

            <Button
                android:id="@+id/btnConnect"
                android:layout_width="0dp"
                android:layout_height="52dp"
                android:layout_weight="1.2"
                android:text="Connect TV"
                android:backgroundTint="#0288D1"
                android:textColor="#FFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Connected TV Info Card -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="#1E293B"
            android:padding="12dp"
            android:layout_marginBottom="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CONNECTED TV DETAILS"
                android:textColor="#94A3B8"
                android:textSize="11sp"
                android:textStyle="bold"
                android:layout_marginBottom="4dp"/>

            <TextView
                android:id="@+id/tvDeviceInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Status: Disconnected / Ready to connect"
                android:textColor="#E2E8F0"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Primary Actions Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <Button
                android:id="@+id/btnScan"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="1. Scan TV Apps"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#2563EB"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />

            <Button
                android:id="@+id/btnDisable"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="2. Debloat TV"
                android:layout_marginStart="4dp"
                android:backgroundTint="#DC2626"
                android:textColor="#FFFFFF"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Secondary Actions Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="12dp">

            <Button
                android:id="@+id/btnInstallLauncher"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="3. Deploy Clean Launcher"
                android:layout_marginEnd="4dp"
                android:backgroundTint="#9333EA"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnFastBoot"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="4. Accelerate Boot Speed"
                android:layout_marginStart="2dp"
                android:layout_marginEnd="2dp"
                android:backgroundTint="#D97706"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />

            <Button
                android:id="@+id/btnRestore"
                android:layout_width="0dp"
                android:layout_height="54dp"
                android:layout_weight="1"
                android:text="5. Restore TV"
                android:layout_marginStart="4dp"
                android:backgroundTint="#16A34A"
                android:textColor="#FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>

        <Button
            android:id="@+id/btnManualGuide"
            android:layout_width="match_parent"
            android:layout_height="46dp"
            android:text="Manual TV Settings Guide (Set Home Launcher)"
            android:backgroundTint="#475569"
            android:textColor="#FFFFFF"
            android:textSize="12sp"
            android:layout_marginBottom="10dp" />

        <TextView
            android:id="@+id/tvAdbHelp"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manual Setup: To select Clean Launcher as default Home app on TV without ADB, go to TV Settings -> Apps -> Default apps -> Home app -> CleanYourTV."
            android:textColor="#FDE047"
            android:textSize="12sp"
            android:padding="8dp"
            android:background="#1E293B"
            android:layout_marginBottom="12dp"/>

        <TextView
            android:id="@+id/tvStatus"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:text="Console Log:\nSelect an action above to begin."
            android:textColor="#CBD5E1"
            android:textSize="12sp"
            android:scrollbars="vertical"
            android:background="#0F172A"
            android:padding="10dp" />

    </LinearLayout>
</ScrollView>
