<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- The only permission: Open-Meteo, for the place search and the current conditions. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@drawable/icon"
        android:label="@string/app_name"
        android:supportsRtl="false"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">

        <!-- Clean Your TV's header line (docs/modules.md): the launcher names this package in its
             header_weather key, reads content://io.github.lostininaka.weatherglance.now/now, and never
             writes here or goes online. The authority is this app's own. -->
        <meta-data
            android:name="com.gathin.tvhome.weather"
            android:value="io.github.lostininaka.weatherglance.now" />

        <provider
            android:name=".WeatherProvider"
            android:authorities="io.github.lostininaka.weatherglance.now"
            android:exported="true" />

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="landscape">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <!-- Clean Your TV module card (docs/specs/card.md): the tile shows as "Weather Glance" once the
                 owner says Show. The card is only the way in; the line under the clock comes from the
                 provider above. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>
    </application>
</manifest>
