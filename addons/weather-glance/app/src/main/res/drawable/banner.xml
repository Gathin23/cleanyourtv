<?xml version="1.0" encoding="utf-8"?>
<!-- The Android TV banner: 320x180, the app's own shapes only. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#10202E"
                android:endColor="#1C3A52"
                android:angle="270" />
        </shape>
    </item>
    <item
        android:width="72dp"
        android:height="72dp"
        android:gravity="center"
        android:drawable="@drawable/icon" />
</layer-list>
