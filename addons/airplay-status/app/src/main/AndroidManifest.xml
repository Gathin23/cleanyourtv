<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <!-- Android requires it for mDNS discovery (NsdManager). The app opens no connection: it only listens on the
         home network for AirPlay announcements while its screen is open. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- This TV's own addresses, to tell its AirPlay announcement apart from other receivers'. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Whether AirPlay Server is installed, and its launch intent. -->
    <queries>
        <package android:name="io.github.jqssun.airplay" />
    </queries>

    <application
        android:allowBackup="false"
        android:banner="@drawable/banner"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@android:style/Theme.DeviceDefault.NoActionBar">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="com.gathin.tvhome.category.DOCK_CARD" />
            </intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/module_card" />
        </activity>
    </application>
</manifest>
