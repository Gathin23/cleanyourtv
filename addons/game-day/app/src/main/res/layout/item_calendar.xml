<?xml version="1.0" encoding="utf-8"?>
<!-- One calendar on the main screen: its colour, name, sport and next entry, and the link masked. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="8dp" android:background="@drawable/row"
    android:focusable="true" android:clickable="true" android:orientation="horizontal"
    android:paddingStart="12dp" android:paddingEnd="16dp" android:paddingTop="10dp" android:paddingBottom="10dp">

    <View android:id="@+id/bar" android:layout_width="5dp" android:layout_height="match_parent"
        android:layout_marginEnd="14dp" />

    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:orientation="vertical">
        <TextView android:id="@+id/name" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:textSize="17sp" android:textColor="#FFFFFFFF" android:singleLine="true" android:ellipsize="end" />
        <TextView android:id="@+id/meta" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="2dp" android:textSize="12sp" android:textColor="#8CFFFFFF"
            android:maxLines="2" android:ellipsize="end" />
    </LinearLayout>

    <TextView android:id="@+id/link" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_gravity="center_vertical" android:layout_marginStart="12dp"
        android:textSize="13sp" android:textColor="#80FFFFFF" android:singleLine="true" />
</LinearLayout>
