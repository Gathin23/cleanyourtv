<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-feature android:name="android.software.leanback" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <application android:allowBackup="false" android:label="@string/app_name" android:icon="@drawable/icon"
        android:banner="@drawable/banner_start" android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity android:name=".CalendarActivity" android:exported="false" android:screenOrientation="landscape" />
        <!-- One alias per tile picture (VnCalendar.variant); DayUpdater keeps exactly one enabled. All are declared
             enabled so the launcher's card check passes whichever one is on. DayStart comes first, so before the
             app's first run the launcher reads its neutral picture instead of a verdict. -->
        <activity-alias android:name=".DayStart" android:targetActivity=".CalendarActivity" android:exported="true"
            android:enabled="true" android:banner="@drawable/banner_start">
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LEANBACK_LAUNCHER" /></intent-filter>
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="com.gathin.tvhome.category.DOCK_CARD" /></intent-filter>
            <meta-data android:name="com.gathin.tvhome.card" android:resource="@xml/card_start" />
        </activity-alias>
        <activity-alias android:name=".Day0" android:targetActivity=".CalendarActivity" android:exported="true"
