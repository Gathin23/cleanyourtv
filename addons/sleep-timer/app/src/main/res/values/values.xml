<?xml version="1.0" encoding="utf-8"?>
<resources>
    <string name="app_name">Sleep Timer</string>
    <string name="hint">Choose when the TV goes to standby. A warning shows one minute before.</string>
    <string name="in_minutes">%1$d min</string>
    <string name="cancel">Cancel the timer</string>
    <string name="state_off">No timer set.</string>
    <string name="state_on">Standby at %1$s.</string>
    <string name="no_service">The Sleep Timer accessibility service is off (run the install script).</string>
    <string name="warning_title">The TV is turning off</string>
    <string name="warning_seconds">in %1$d seconds</string>
    <string name="more">15 more minutes</string>
