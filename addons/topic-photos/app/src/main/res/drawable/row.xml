<?xml version="1.0" encoding="utf-8"?>
<!-- A settings row: light when focused, a faint glass otherwise. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle"><solid android:color="#FFF1F3F6" /><corners android:radius="18dp" /></shape>
    </item>
    <item>
        <shape android:shape="rectangle"><solid android:color="#1AFFFFFF" /><corners android:radius="18dp" /></shape>
    </item>
</selector>
