<?xml version="1.0" encoding="utf-8"?>
<!-- No flagRequestFilterKeyEvents, on purpose: a key-filtering service is what stops held volume from
     repeating on these sets. This service only needs to stay bound; it reads no window content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeAnnouncement"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:canRetrieveWindowContent="false"
    android:description="@string/service_description"
    android:notificationTimeout="0" />
