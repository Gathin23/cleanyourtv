<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:background="#F2080B10"
    android:padding="32dp">

    <!-- Header -->
    <TextView
        android:id="@+id/lock_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="YouTube Daily Limit"
        android:textColor="#FFFFFF"
        android:textSize="32sp"
        android:fontFamily="sans-serif-medium"
        android:layout_marginBottom="8dp" />

    <TextView
        android:id="@+id/lock_subtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Daily limit reached. Enter 4-digit PIN to continue."
        android:textColor="#B0B8C4"
        android:textSize="18sp"
        android:layout_marginBottom="24dp" />

    <!-- PIN circles -->
    <LinearLayout
        android:id="@+id/pin_dots_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp">

        <ImageView
            android:id="@+id/dot_0"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:src="@drawable/pin_circle_empty" />

        <ImageView
            android:id="@+id/dot_1"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:src="@drawable/pin_circle_empty" />

        <ImageView
            android:id="@+id/dot_2"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:src="@drawable/pin_circle_empty" />

        <ImageView
            android:id="@+id/dot_3"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_margin="8dp"
            android:src="@drawable/pin_circle_empty" />
    </LinearLayout>

    <TextView
        android:id="@+id/pin_error"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Incorrect PIN"
        android:textColor="#FF5555"
        android:textSize="16sp"
        android:visibility="invisible"
        android:layout_marginBottom="16dp" />

    <!-- Extension Options (Shown after valid PIN) -->
    <LinearLayout
        android:id="@+id/extension_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btn_ext_30"
            android:layout_width="160dp"
            android:layout_height="54dp"
            android:layout_margin="8dp"
            android:background="@drawable/key_bg"
            android:textColor="@color/key_text_color"
            android:textSize="17sp"
            android:text="+30 Minutes" />

        <Button
            android:id="@+id/btn_ext_60"
            android:layout_width="160dp"
            android:layout_height="54dp"
            android:layout_margin="8dp"
            android:background="@drawable/key_bg"
            android:textColor="@color/key_text_color"
            android:textSize="17sp"
            android:text="+1 Hour" />

        <Button
            android:id="@+id/btn_ext_all"
            android:layout_width="160dp"
            android:layout_height="54dp"
            android:layout_margin="8dp"
            android:background="@drawable/key_bg"
            android:textColor="@color/key_text_color"
            android:textSize="17sp"
            android:text="Unlock Today" />
    </LinearLayout>

    <!-- Keypad Container -->
    <LinearLayout
        android:id="@+id/keypad_container"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Row 1 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/key_1" style="@android:style/Widget.Button"
                android:layout_width="72dp" android:layout_height="60dp" android:layout_margin="6dp"
                android:background="@drawable/key_bg" android:textColor="@color/key_text_color" android:textSize="22sp" android:text="1" />
            <Button android:id="@+id/key_2" style="@android:style/Widget.Button"
                android:layout_width="72dp" android:layout_height="60dp" android:layout_margin="6dp"
                android:background="@drawable/key_bg" android:textColor="@color/key_text_color" android:textSize="22sp" android:text="2" />
            <Button android:id="@+id/key_3" style="@android:style/Widget.Button"
                android:layout_width="72dp" android:layout_height="60dp" android:layout_margin="6dp"
                android:background="@drawable/key_bg" android:textColor="@color/key_text_color" android:textSize="22sp" android:text="3" />
        </LinearLayout>

        <!-- Row 2 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/key_4" style="@android:style/Widget.Button"
                android:layout_width="72dp" android:layout_height="60dp" android:layout_margin="6dp"
                android:background="@drawable/key_bg" android:textColor="@color/key_text_color" android:textSize="22sp" android:text="4" />
            <Button android:id="@+id/key_5" style="@android:style/Widget.Button"
                android:layout_width="72dp" android:layout_height="60dp" android:layout_margin="6dp"
                android:background="@drawable/key_bg" android:textColor="@color/key_text_color" android:textSize="22sp" android:text="5" />
            <Button android:id="@+id/key_6" style="@android:style/Widget.Button"
                android:layout_width="72dp" android:layout_height="60dp" android:layout_margin="6dp"
                android:background="@drawable/key_bg" android:textColor="@color/key_text_color" android:textSize="22sp" android:text="6" />
        </LinearLayout>

        <!-- Row 3 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/key_7" style="@android:style/Widget.Button"
                android:layout_width="72dp" android:layout_height="60dp" android:layout_margin="6dp"
                android:background="@drawable/key_bg" android:textColor="@color/key_text_color" android:textSize="22sp" android:text="7" />
            <Button android:id="@+id/key_8" style="@android:style/Widget.Button"
                android:layout_width="72dp" android:layout_height="60dp" android:layout_margin="6dp"
                android:background="@drawable/key_bg" android:textColor="@color/key_text_color" android:textSize="22sp" android:text="8" />
            <Button android:id="@+id/key_9" style="@android:style/Widget.Button"
                android:layout_width="72dp" android:layout_height="60dp" android:layout_margin="6dp"
                android:background="@drawable/key_bg" android:textColor="@color/key_text_color" android:textSize="22sp" android:text="9" />
        </LinearLayout>

        <!-- Row 4 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <Button android:id="@+id/key_del" style="@android:style/Widget.Button"
                android:layout_width="72dp" android:layout_height="60dp" android:layout_margin="6dp"
                android:background="@drawable/key_bg" android:textColor="@color/key_text_color" android:textSize="18sp" android:text="⌫" />
            <Button android:id="@+id/key_0" style="@android:style/Widget.Button"
                android:layout_width="72dp" android:layout_height="60dp" android:layout_margin="6dp"
                android:background="@drawable/key_bg" android:textColor="@color/key_text_color" android:textSize="22sp" android:text="0" />
            <Button android:id="@+id/key_exit" style="@android:style/Widget.Button"
                android:layout_width="72dp" android:layout_height="60dp" android:layout_margin="6dp"
                android:background="@drawable/key_bg" android:textColor="@color/key_text_color" android:textSize="16sp" android:text="Exit" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>

