<?xml version="1.0" encoding="utf-8"?>
<!-- One print: the whole photo with rounded corners, its month and year in white over a fade along its foot, and a
     soft halo for a shadow (PrintShadow, the outer frame's background). Prints sizes the photo to its own shape, so
     nothing is cropped.
     The outer frame is a clear margin the photo and its shadow are drawn into as one hardware layer: tilted, the
     layer is filtered as a whole, so the edges come out smooth instead of stair-stepped. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="@dimen/print_shadow_room"
    android:clipToPadding="false"
    android:clipChildren="false">

    <FrameLayout
        android:id="@+id/printCard"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/print_card">

        <ImageView
            android:id="@+id/printPhoto"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="fitXY"
            android:importantForAccessibility="no" />

        <TextView
            android:id="@+id/printDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="bottom"
            android:background="@drawable/print_caption_fade"
            android:gravity="start|bottom"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="32dp"
            android:paddingBottom="12dp"
            android:singleLine="true"
            android:textColor="#F2FFFFFF"
            android:textSize="16sp"
            android:fontFamily="@font/outfit_medium"
            android:letterSpacing="0.04"
            android:shadowColor="#80000000"
            android:shadowRadius="4" />
    </FrameLayout>
</FrameLayout>
