<?xml version="1.0" encoding="utf-8"?>
<!-- The PIN screen: the lock itself, and the owner check in front of the settings. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF05060C"
    android:gravity="center"
    android:orientation="vertical">

    <TextClock
        android:id="@+id/clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-light"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:textColor="#FFFFFFFF"
        android:textSize="72sp" />

    <TextView
        android:id="@+id/title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:textColor="#E6FFFFFF"
        android:textSize="24sp" />

    <LinearLayout
        android:id="@+id/cells"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="36dp"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:orientation="horizontal">

        <TextView style="@style/Cell" />
        <TextView style="@style/Cell" />
        <TextView style="@style/Cell" />
        <TextView style="@style/Cell" />
        <TextView style="@style/Cell" />
        <TextView style="@style/Cell" />
    </LinearLayout>

    <TextView
        android:id="@+id/message"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:textColor="#FFFF8A80"
        android:textSize="17sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="@string/pin_hint"
        android:textColor="#80FFFFFF"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/ask"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:text="@string/ask_hint"
        android:textColor="#80FFFFFF"
        android:textSize="14sp"
        android:visibility="gone" />
</LinearLayout>
