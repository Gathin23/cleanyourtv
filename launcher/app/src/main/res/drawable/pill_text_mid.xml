<?xml version="1.0" encoding="utf-8"?>
<!-- Secondary lines of a focused list row (package, signing key, an input's "Connected"): dark enough
     to read on the white focused background at 10sp; unfocused a dim white on the dark glass. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true" android:color="#E6111111" />
    <item android:color="#73FFFFFF" />
</selector>
