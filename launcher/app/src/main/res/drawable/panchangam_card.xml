<?xml version="1.0" encoding="utf-8"?>
<!-- Liquid-glass look without a blur (the launcher has none, for 1 GB TVs): a milky fill lighter at the top, a sheen
     over the upper edge, a crisp light rim and a fainter inner rim, so the wallpaper still shows through. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- A soft drop shadow under the slab. -->
    <item android:top="4dp">
        <shape android:shape="rectangle">
            <solid android:color="#26000000" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#38FFFFFF" android:centerColor="#1AFFFFFF"
                android:endColor="#14FFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <!-- The specular sheen: bright along the top edge, gone by the middle. -->
    <item android:bottom="70dp" android:left="1dp" android:right="1dp" android:top="1dp">
        <shape android:shape="rectangle">
            <gradient android:angle="270" android:startColor="#2EFFFFFF" android:endColor="#00FFFFFF" />
            <corners android:topLeftRadius="29dp" android:topRightRadius="29dp" />
        </shape>
    </item>
    <item android:bottom="4dp">
        <shape android:shape="rectangle">
            <stroke android:width="1.5dp" android:color="#73FFFFFF" />
            <corners android:radius="30dp" />
        </shape>
    </item>
    <item android:bottom="6dp" android:left="2dp" android:right="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <stroke android:width="1dp" android:color="#1FFFFFFF" />
            <corners android:radius="28dp" />
        </shape>
    </item>
</layer-list>
