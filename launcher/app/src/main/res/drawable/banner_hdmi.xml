<?xml version="1.0" encoding="utf-8"?>
<!-- Banner for an HDMI/input shortcut tile (config.xml, app_banners): a dark slate-blue field with the input glyph. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:width="320dp" android:height="180dp">
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#FF2B3A5E" android:endColor="#FF11182B" />
        </shape>
    </item>
    <item android:width="76dp" android:height="76dp" android:gravity="center"
        android:drawable="@drawable/ic_input" />
</layer-list>
