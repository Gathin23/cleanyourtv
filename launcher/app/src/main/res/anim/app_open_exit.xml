<?xml version="1.0" encoding="utf-8"?>
<!--
  App launch: the launcher exits.
  Fades to 20% and scales up slightly — a crisp, confident push that gives the launched
  app the feeling of growing out of the focused tile.  180 ms is fast enough that it
  does not delay the app's own splash.
-->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@android:interpolator/decelerate_cubic"
    android:duration="180">
    <alpha android:fromAlpha="1.0" android:toAlpha="0.2" />
    <scale android:fromXScale="1.0" android:toXScale="1.03"
        android:fromYScale="1.0" android:toYScale="1.03"
        android:pivotX="50%" android:pivotY="50%" />
</set>
