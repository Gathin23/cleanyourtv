<?xml version="1.0" encoding="utf-8"?>
<!-- Keys only: the service subscribes to window changes at runtime only when a vendor source panel is
     configured, to track whether that panel is open. It never retrieves or inspects window content. -->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagRequestFilterKeyEvents"
    android:canRequestFilterKeyEvents="true"
    android:description="@string/input_key_service_description" />
