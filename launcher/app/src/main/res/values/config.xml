<?xml version="1.0" encoding="utf-8"?>
<!--
  Launcher configuration. Edit this file, then run launcher/build-and-install.sh.
  Or leave it and push a theme instead: tools/theme.sh themes/<name> puts a config.json (same keys, see
  themes/README.md) and an optional wallpaper on the TV, and the launcher overlays it at start.
  Package names: on the TV run `pm list packages` (tools/tv.py 'pm list packages').
-->
<resources>

    <!-- Tried in order when no standard settings handler is usable; each package must also be visible
         through <queries> in the manifest. -->
    <string-array name="settings_fallback_components" translatable="false">
        <item>com.xiaomi.mitv.settings/com.xiaomi.mitv.settings.entry.MainActivity</item>
        <item>com.tcl.settings/com.tcl.settings.ui.MainActivity</item>
        <item>com.amazon.tv.launcher/com.amazon.tv.launcher.ui.MainSettingsActivity</item>
    </string-array>

    <!-- Apps pinned to the dock row at the bottom, in this order. Missing apps are skipped. -->
    <string-array name="dock_apps">
        <item>com.netflix.ninja</item>
        <item>com.amazon.amazonvideo.livingroom</item>
        <item>com.google.android.youtube.tv</item>
        <item>in.startv.hotstar</item>
    </string-array>
    <!-- With fewer dock_apps than columns (or a dock app that is not installed), the free dock slots take
         the first grid apps, so the dock never shows a gap. false leaves them empty (#162); a theme can
         set "fill_dock": false. -->
    <bool name="fill_dock">true</bool>

    <!-- Apps never shown as tiles (e.g. the Live TV app, which the Inputs menu already covers). -->
    <string-array name="hidden_apps">
        <item>com.mediatek.wwtv.tvcenter</item>
        <item>com.mitv.gallery</item>
    </string-array>

    <!-- The TV's Live TV / tuner app, offered at the end of the Inputs menu. Leave empty to omit. -->
    <string name="live_tv_package" translatable="false">com.mediatek.wwtv.tvcenter</string>

    <!-- Open the Live TV app above the first time Home comes up after the TV is switched on, for sets that are
         mostly used for broadcast TV. Once per boot: Home after that stays Home. Can also be set with
         "boot_to_live_tv": true in a theme's config.json. -->
    <bool name="boot_to_live_tv">false</bool>

    <!-- An "Open on start" row in Launcher settings: pick any app on the TV, and the first time Home comes up
         after the TV starts it opens that app instead. Once per boot, like boot_to_live_tv (which wins when
         both are set); Home after that stays Home, and an app that is gone or disabled leaves Home on screen.
         Off by default; a theme can set "open_on_start_choice": true. -->
    <bool name="open_on_start_choice">false</bool>

    <!-- Some TVs give their Live TV app no leanback entry point at all, so `live_tv_package` above
         resolves to nothing (TCL Android TV 9 on China-market sets is one). This action is then sent
         to that package instead, and the app starts normally. Leave empty to omit. -->
    <string name="live_tv_action" translatable="false"></string>

    <!-- Optional exact system tuner ID for the Inputs menu's Live TV row, e.g. the DVB-S input on
         a TV with separate antenna, cable and satellite tuners. It opens that input's channel
         collection, restricted to live_tv_package. Empty keeps automatic selection and its existing
         OEM passthrough route. If the ID is absent or the app cannot handle the collection, open
         the Live TV app normally instead of selecting a different input. A wrong but registered ID
         can open the app's tuner setup screen instead; that is not detected as a fallback condition.
         Use a verified input ID, or leave this empty. See docs/devices/haam-r4.md. -->
    <string name="live_tv_input_id" translatable="false"></string>

    <!-- Tiles that open a screen of the app instead of its start screen: "package=action", sent to that package.
         A tile whose action no longer resolves opens the app normally. MagentaTV's program guide:
         com.telekom.onetv.tv.pl=com.telekom.onetv.tv.pl.action.PROGRAM_GUIDE. -->
    <string-array name="launch_actions">
    </string-array>

    <!-- A tile's name instead of the app's own: "package=Name". It also shows above the dock. -->
    <string-array name="app_labels">
    </string-array>
    <!-- A tile's artwork instead of the app's banner: "package=drawable", a banner_* drawable bundled with the
         launcher (res/drawable). banner_tv is a magenta field with the Live TV glyph. -->
    <string-array name="app_banners">
    </string-array>

    <!-- TVs with no TvInputManager have no HDMI list to read, but their own source-selection panel
         still switches inputs (TCL Android TV 9 again). When nothing could be listed, the Inputs menu
         offers one row that starts this service: component first, then action. The component can also be an
         activity, for sets whose panel is a dialog (BYINTEK U4). With no Live TV app either, the Inputs pill
         opens the panel directly instead of a menu. Leave empty to omit. -->
    <string name="source_panel_service" translatable="false"></string>
    <string name="source_panel_action" translatable="false"></string>
    <!-- One int extra sent with the source panel intent, "name=value". Coocaa OS (Skyworth, China) needs
         control_center_command=100 for its control center to open on the source row, as the remote's
         Source button does. Leave empty to omit. -->
    <string name="source_panel_extra" translatable="false"></string>

    <!-- Coocaa OS (Skyworth, China) registers no inputs with TvInputManager; com.skyworth.tv lists its
         sources (HDMI 1, HDMI 2, AV, the tuner) through its own provider instead. true: show those in the
         Inputs menu and switch with com.skyworth.tv, ahead of the source panel above, which stays as the
         fallback. See CoocaaSources and examples/skyworth-7s60-a5. -->
    <bool name="coocaa_sources">false</bool>

    <!-- Inputs menu: HDMI and AV rows normally open with ACTION_VIEW on the input's channel URI, which the
         Live TV app handles. Where nothing answers that, this action is sent with the same URI instead
         (XGIMI projectors: com.xgimi.action.hdmiPlayer). Leave empty to omit. -->
    <string name="input_action" translatable="false"></string>
    <!-- Inputs menu: a scheme to send the input's passthrough URI with instead of content:// (and no channel MIME
         type). YaOS: live-tv. Its source player answers live-tv://android.media.tv/passthrough/<input>, while the
         content:// URI goes to its channel player, which resumes the last film it played. Leave empty to omit. -->
    <string name="input_uri_scheme" translatable="false"></string>

    <!-- Whether HomeKeyService and InputKeyService actually request key filtering (config.xml or a theme's
         "key_filter"). Some firmware (TCL Google TV on Android 12) drops key auto-repeat once ANY service
         filters keys, so long-pressing volume only steps once: set false and the service keeps running but
         stops filtering, which brings repeat back at the price of the remote buttons below doing nothing. -->
    <bool name="key_filter">true</bool>

    <!-- With key_filter on, true makes HomeKeyService and InputKeyService stop filtering keys while a game
         controller is connected, so games see its buttons (Steam Link with an Xbox controller on a TCL G07
         did not; Moonlight with two controllers put both on player 1, docs/TROUBLESHOOTING.md). The price: the
         remote buttons below do nothing until the controller disconnects. A voice
         remote that reports a joystick does not count. A theme can set it ("gamepad_passthrough"). -->
    <bool name="gamepad_passthrough">false</bool>

    <!-- With key_filter on, the key helpers swallow Volume Up/Down and repeat a held one themselves. For firmware
         that applies a volume key before the filter and again when the helper hands it back, so one tap moves two
         steps (TCL G03 / BeyondTV4 on Android 11, #1100); a swallowed key gets no auto-repeat from Android, hence
         the helper's own. Leave it off where a tap is one step. A theme can set it ("consume_volume_keys"). -->
    <bool name="consume_volume_keys">false</bool>

    <!-- Vendor source numbers for the Inputs menu, "HW<n>=<number>" by the framework input id's last part
         (`tools/tv.py 'dumpsys tv_input'` lists them). A mapped input opens by sending input_action with the
         number as the int extra "input"; "HW<n>=-" leaves a port the board reports but the set does not have
         out of the menu. A theme can set the same list. Xiaomi/Redmi China firmware (MiTV-MFTP0) needs input_action
         com.xiaomi.mitv.tvplayer.EXTSRC_PLAY and MStar numbers: HW5=23, HW6=24, HW7=25, HW8=-, HW2=2,
         HW3=-, HW4=- (see examples/redmi-mitv-mftp0). Leave empty to omit. -->
    <string-array name="input_sources" translatable="false">
    </string-array>

    <!-- Remote buttons that open Settings, by Linux scancode (HOME_KEY_SERVICE=1 build-and-install.sh). Remotes
         that send KEYCODE_SETTINGS need no entry. Some send a code Android does not map: the Xiaomi/Fengmi
         projector remote's gear button is scancode 384 (KEY_TAPE). Find yours with
         `tools/tv.py 'getevent -lt'` while pressing the button - but a HID consumer-control usage prints an
         evdev MSC_SCAN there, which is not always the scanCode the framework reports, so a number that takes
         nothing is no proof the press never arrived. Leave empty to omit. -->
    <integer-array name="settings_key_scancodes">
    </integer-array>
    <!-- The same by Android keycode, for buttons whose scancode is shared. TCL Google TV remotes send their
         Settings button as keycode 83 (KEYCODE_NOTIFICATION, which the stock Google TV home turned into its quick
         settings panel) on scancode 240 (KEY_UNKNOWN), the scancode several TCL buttons share. Find the keycode
         with `tools/tv.py 'logcat -v time -s InputReader:D'` while pressing the button - some firmwares print no
         key line there at any verbosity, and a `getevent` MSC_SCAN is a different number, so the reliable route is
         a temporary `Log.d` in the helper's `onKeyEvent`: `getKeyCode()`, `getScanCode()`, `getDeviceId()`, read
         after a HOME_KEY_SERVICE=1 rebuild. Leave empty to omit. -->
    <integer-array name="settings_key_keycodes">
    </integer-array>
    <!-- What those Settings buttons open: false, the TV's Settings; true, a small glass panel at the top right
         with TV settings, Display, Network, Apps (re-enable an app) and Launcher settings, over whatever is on screen.
         Both keys can also be set from a theme's config.json ("settings_key_keycodes": [83]). -->
    <bool name="settings_key_panel">false</bool>

    <!-- A force stop of the launcher (Settings, a cleaner app, am force-stop) takes HomeKeyService and InputKeyService
         off the enabled list. true: Home puts the helpers that were running back when it starts; one turned off in
         Settings stays off. Needs WRITE_SECURE_SETTINGS, which build-and-install grants with RESTORE_KEY_SERVICES=1
         (-RestoreKeyServices on Windows). Can also be set with "restore_key_services": true in a theme's config.json. -->
    <bool name="restore_key_services">false</bool>

    <!-- More remote buttons that open the input switcher, by Android keycode (INPUT_KEY_SERVICE=1
         build-and-install.sh; KEYCODE_TV always does). For buttons only a disabled app answered: the Xiaomi
         MiTV-AXFR2 remote's PatchWall button is 192 (KEYCODE_BUTTON_5). `dumpsys window policy` lists which
         app each such "global key" was routed to. Check with the real remote: keys injected over ADB never
         reach InputKeyService. Leave empty to omit. -->
    <integer-array name="input_key_keycodes">
    </integer-array>
    <!-- Answer the system input switcher (com.android.tv.action.VIEW_INPUTS) with the Inputs menu. For TVs whose
         stock launcher was the only handler of that action, so the remote's Input button does nothing once the
         stock launcher is disabled even with InputKeyService on (Hisense huangshan, Android TV 10: no
         global_keys.xml, no vendor input picker). Off by default: a TV with its own input picker would otherwise
         get a chooser on every press. Also "handle_view_inputs": true in a theme's config.json. -->
    <bool name="handle_view_inputs">false</bool>
    <!-- Remote buttons that open an app, as "keycode:package" or "KEYCODE_NAME:package" (INPUT_KEY_SERVICE=1 or
         HOME_KEY_SERVICE=1; both read this one list, and a theme's config.json can set it too). On Google TV the
         YouTube button sends 190 (KEYCODE_BUTTON_3) to the stock launcher, so it does nothing once launcherx
         is disabled (Chromecast with Google TV, Xiaomi MiTV-AXFR2): 190:com.google.android.youtube.tv brings
         it back. The KTC LUMIO VISION remote (Realtek Google TV) sends Netflix 191, YouTube 190, Prime Video 195
         and TL;DR 200. Some remotes send several app buttons as one keycode and tell them apart only by scancode
         (Sony BRAVIA: YouTube, Prime Video and Disney+ are all keycode 196, scancodes 485, 490 and 491); list those
         as "scan:scancode:package", e.g. scan:490:com.wbd.hbomax, found with `tools/tv.py 'getevent -lt'` (the
         EV_KEY code, in hex). A scancode entry wins over a keycode. In place of a package, "input:<input id>"
         switches to that TV input, e.g. scan:227:input:com.tcl.tvinput/.passthroughinput.TvPassThroughService/HW1413744640
         for HDMI 3 on a TCL Smart TV Pro; the ids are in `tools/tv.py 'dumpsys tv_input'` (hdmi_port=N under
         TvInputHardwareInfo). An action word in place of a package runs that action instead: back, home, recents,
         mute (toggles the sound, with the TV's volume bar), sleep (standby, Android 9 and later), screensaver (the
         one chosen in the TV's settings, or the launcher's clock), settings or wifi; e.g. KEYCODE_PROG_YELLOW:mute
         and hold:KEYCODE_PROG_YELLOW:sleep. "package/.Activity" opens that activity instead of the app's launcher
         entry, e.g. hold:191:io.github.maxhayim.brightness/.QuickActivity for an add-on's quick bar. Prefix an
         entry with "hold:" for the same button's long press:
         "hold:KEYCODE_BUTTON_8:org.xbmc.kodi" opens Kodi when held for half a second, while the unprefixed entry
         still opens on a tap; "hold:scan:490:..." works for scancodes. A key with only a hold entry does nothing
         on a tap. A listed app that is not installed leaves the button doing nothing. Prefix an entry with "front:"
         for what a tap does while the button's own app is already in front (HOME_KEY_SERVICE=1), and use
         "guide:<package>" as a target to open that Live TV app's program guide: "172:com.vt.tv.tvcenter" with
         "front:172:guide:com.vt.tv.tvcenter" makes the Hisense hengshan Live TV button open Live TV, then its guide,
         where the firmware hands KEYCODE_GUIDE (172) to the stock launcher and no app ever receives it. Leave empty
         to omit. -->
    <string-array name="app_keys" translatable="false">
    </string-array>

    <!-- Package of the stock launcher, for TVs whose firmware turns it back on after it was disabled. XGIMI's
         com.xgimi.xrmservice does, on every one of its remote keys, power included (docs/TROUBLESHOOTING.md).
         Whenever that launcher's home screen comes up anyway, HomeKeyService (HOME_KEY_SERVICE=1) sends the TV
         straight back here. A theme's config.json can set it too. Leave empty to omit. -->
    <string name="stock_home_redirect" translatable="false"></string>

    <!-- For TVs whose firmware opens the Live TV app (live_tv_package) by itself at every power-on, with no setting
         to change it (Changhong / Homwee boards start com.mediatek.wwtv.tvcenter from its own boot receiver, which
         adb cannot disable on Android 14). While nobody has pressed a key yet after boot or after the screen turns
         on, HomeKeyService (HOME_KEY_SERVICE=1) sends a Live TV window back to Home; the first key hands control
         to the user, so opening Live TV on purpose is never undone. The opposite of boot_to_live_tv, and ignored
         when that is on. A theme's config.json can set it too. Off by default. -->
    <bool name="power_on_home">false</bool>
    <!-- Home at every power-on, whatever the firmware put in front (the last HDMI input, Live TV or an app),
         for TVs that come back to the last source, like Philips. Needs HOME_KEY_SERVICE=1; a key pressed first
         wins. Ignored with boot_to_live_tv or an Open on start app. Can also be set with "power_on_home_always". -->
    <bool name="power_on_home_always">false</bool>

    <!-- Every press of the remote's Home button opens this launcher, a held one too. Android turns a Home press held
         past the long-press timeout (400 ms) into its long-press action; on Android TV that is ALL_APPS, sent to the
         system-image launcher, and with the stock launcher disabled nothing answers it, so a firm press on a slow
         remote does nothing (Philips TPM191E, Android 12). The long_press_timeout setting does not move that limit
         there. HomeKeyService (HOME_KEY_SERVICE=1) then takes the Home key itself and opens Home on release. Needs
         key_filter, so held keys such as Volume Up/Down stop repeating (confirmed on that Philips; single presses
         still step). A theme's config.json can set it too. Off by default. -->
    <bool name="home_long_press_home">false</bool>

    <!-- Show the Solar Hijri (Shamsi) date used in Iran and Afghanistan, e.g. "27 Mehr 1405", above the
         Gregorian date. -->
    <bool name="shamsi_date">false</bool>
    <!-- Lunisolar (Vietnamese / Chinese / Korean) date under the date; config.json lunar_date, lunar_utc_offset (7, 8 or 9, default by locale). -->
    <bool name="lunar_date">false</bool>
    <!-- The date (with the Shamsi and lunar lines) on its own line under the clock instead of beside it, for a top bar
         whose pills leave the date too little room. Can also be set with "date_below_clock" in a theme. -->
    <bool name="date_below_clock">false</bool>
    <!-- The language the launcher shows itself in, as a language tag ("vi", "pt-BR", "ar-EG-u-nu-latn"
         for Arabic with Western digits), instead of the TV's. For firmware
         that has no menu entry for the owner's language although the launcher is translated into it (a China-market
         Xiaomi offers Chinese and English only). Empty, the default, follows the TV. A theme can set it ("locale"). -->
    <string name="locale" translatable="false"></string>

    <!-- A name after the greeting: "Mr. Trịnh" shows GOOD MORNING, MR. TRỊNH. Empty: the greeting alone. -->
    <string name="greeting_name" translatable="false"></string>
    <!-- The greeting above the clock ("Good evening"). false hides it. Can also be set with "show_greeting" in a theme. -->
    <bool name="show_greeting">true</bool>
    <!-- The date and the line between the clock and the date in the clock's full white instead of dimmed. Can also be
         set with "header_white" in a theme. -->
    <bool name="header_white">false</bool>
    <!-- Optional VPN app the network pill opens (hold the pill for Wi-Fi settings), e.g. the package of the
         VPN you use. Empty: the pill opens Wi-Fi settings. The green VPN badge shows for any VPN either way;
         with an app set here, a red "VPN off" badge also shows while no VPN is up. -->
    <string name="vpn_app" translatable="false"></string>
    <!-- The VPN as its own pill after the network pill, instead of a badge inside it: solid green with a lock while a
         VPN is up, solid red "VPN off" while none is and vpn_app is installed. Pressing it opens vpn_app (without it,
         the App library, or VPN settings when app_library is off), and the network pill then always opens Wi-Fi
         settings. Hidden while no VPN is up and vpn_app is empty or not installed, and with top_menu. It keeps its
         label with icon_only_buttons, since the red state has no icon. A VPN app's kill switch keeps a VPN up while
         the app says disconnected (it holds the tunnel to block traffic), so the pill stays green then. Can also be
         set with "vpn_pill" in a theme. -->
    <bool name="vpn_pill">false</bool>
    <!-- The dock as its own row: a lighter band, no names under the tiles, parked low on the screen with the top
         shelf above it. false makes the dock apps simply the first tiles of one plain grid (still in dock_apps
         order, no empty slots), with names under every tile and the glow behind every focused tile. -->
    <bool name="dock_row">true</bool>
    <!-- Inputs, Wi-Fi and Settings folded into one round gear at the top right, like Google TV: OK drops a menu
         with the three, hold OK keeps the launcher menu. Off by default; a theme can set "top_menu": true. -->
    <bool name="top_menu">false</bool>
    <!-- A direct Launcher settings action instead of TV Settings in the header (or top_menu).
         Off by default; a theme can set "launcher_settings_button": true. -->
    <bool name="launcher_settings_button">false</bool>
    <!-- The dock band as light frosted glass, like the Inputs, Wi-Fi and Settings pills, so a sky or wallpaper shows
         through it. false (the default) keeps the solid near-black band, or the cinematic shelf's dark glass. Can
         also be set with "dock_glass": true in a theme's config.json. -->
    <bool name="dock_glass">false</bool>
    <!-- Draw the dock band and its edge. false leaves the tiles floating on the wallpaper (config.xml dock_band). -->
    <bool name="dock_band">true</bool>
    <!-- Every app in one row: the dock apps first, the rest after them, and the row scrolls sideways when focus
         reaches its edge. No grid below; rows_below_dock is ignored. Needs dock_row. Can also be set with
         "single_row" in a theme. -->
    <bool name="single_row">false</bool>
    <!-- With single_row, the band runs behind every app in the row, apps installed later included, instead of
         the dock apps only. Can also be set with "dock_band_all" in a theme. -->
    <bool name="dock_band_all">false</bool>
    <!-- The dock band's padding equals the gap between its tiles on all four sides (as far as the grid's edges leave room),
         so its corners are concentric with the tiles' and the spacing reads even. false (the default) keeps the fixed
         14dp above and below, up to 22dp at the sides and 26dp corners. Can also be set with "dock_even_padding": true in a theme's config.json. -->
    <bool name="dock_even_padding">false</bool>
    <!-- A reorder button (two arrows) in the top bar. Off by default: reordering is also in the Settings
         button's long-press menu, so it needs no extra button on screen. -->
    <bool name="reorder_button">false</bool>
    <!-- Wi-Fi and Settings as round icon-only buttons (the network name moves to the talkback description);
         Inputs keeps its label. -->
    <bool name="icon_only_buttons">false</bool>
    <!-- The Inputs pill as a round icon button too (the label moves to the talkback description). -->
    <bool name="icon_only_inputs">false</bool>
    <!-- true colours the Wi-Fi pill's icon green while the TV is online and leaves it white while it is not (dark on
         the focused pill either way), so the connection shows at a glance, also as an icon-only button. Can also be
         set with "wifi_status_color": true in a theme's config.json. -->
    <bool name="wifi_status_color">false</bool>
    <!-- With wifi_status_color: the icon orange while the TV is connected but Android has not reached the internet
         through it (a hotel or holiday-park Wi-Fi waiting for its login page) and red while it is offline, instead
         of white for both. Can also be set with "wifi_status_warnings": true in a theme's config.json. -->
    <bool name="wifi_status_warnings">false</bool>
    <!-- The app library as a round button in the top bar, beside Settings (app_library must be on too). -->
    <bool name="library_button">false</bool>
    <!-- The App library pill after the last Home row. false hides it while library_button is on, so the top-bar
         button stays the way in, and Down from the last row stays put as with app_library off. Can also be set
         with "show_library_pill": false in a theme's config.json. -->
    <bool name="show_library_pill">true</bool>
    <!-- With icon_only_buttons: keep the network name on the Wi-Fi pill up to this width in dp, cut with an ellipsis.
         0 leaves the Wi-Fi pill as an icon. -->
    <integer name="wifi_label_width">0</integer>

    <!-- The Wi-Fi/Ethernet pill in the top bar. false hides it (on Android 14 with Location off it can
         only say "Wi-Fi", not the network name). Can also be set with "show_network_pill" in a theme. -->
    <bool name="show_network_pill">true</bool>
    <!-- Apps shown as round buttons with their own logo in the top bar, left of the network pill, in this order.
         They leave the grid. Missing apps are skipped. Can also be set with "top_bar_apps" in a theme. -->
    <string-array name="top_bar_apps" translatable="false">
    </string-array>
    <!-- The Inputs pill in the top bar, shown when the TV has inputs to list. false hides it for good; what the
         remote's Input button does is unchanged. Can also be set with "show_inputs_pill" in a theme. -->
    <bool name="show_inputs_pill">true</bool>
    <!-- The Inputs list shows only HDMI ports and CEC devices that report connected. Empty ports, devices asleep in
         standby (some TVs, TCL among them, report an empty HDMI port as connected-standby, the same state a
         sleeping device has) and the AV jacks fold behind a "More inputs" row that expands the rest. An HDMI row
         whose state the TV cannot be trusted with stays. Off by default: every input is listed. Can also be set
         with "inputs_connected_only" in a theme. -->
    <bool name="inputs_connected_only">false</bool>
    <!-- Names under every tile, not only the focused one: unfocused names stay dimmed, the focused one is full white.
         With dock_row the band grows down to hold the dock's names too. -->
    <bool name="always_show_names">false</bool>
    <!-- Wallpapers decode as RGB_565 (2 bytes a pixel, 4 MB at 1080p), which bands dark gradients such as a night
         sky, most of all under wallpaper_dim. true decodes them in 32-bit colour: 8 MB, for TVs with 2 GB or more. -->
    <bool name="wallpaper_true_color">false</bool>
    <!-- Rotating wallpapers: show each picture's name under the top-right buttons, from a captions.txt next to the
         pictures in wallpapers/ ("01-dusk.jpg<TAB>Dusk over the peaks", one per line). A picture without a line
         shows no name. Can also be set with "wallpaper_captions": true in a theme's config.json. -->
    <bool name="wallpaper_captions">false</bool>
    <!-- Rotating wallpapers grouped by the time of day, as JSON: {"morning": [file names], "evening": [...],
         "night": [...]}. While set, the rotation picks only from the group that fits now: morning from sunrise to
         noon, evening until half an hour after sunset, night the rest, with the sun at latitude and longitude (07:00
         and 18:30 without them). It moves to the new group as soon as the time of day changes. A missing or empty
         group falls back to the whole collection; empty rotates through every picture. A theme can set
         "wallpaper_moods" as an object. -->
    <string name="wallpaper_moods" translatable="false"></string>
    <!-- Hold OK on a tile opens a small menu: Move (picks the tile up for reordering), Remove from Home (only with
         app_library) and App info. false keeps the old behaviour: holding OK opens the app's App info page.
         Can also be set with "tile_menu": true in a theme's config.json. -->
    <bool name="tile_menu">false</bool>

    <!-- Grid rows left visible under the dock on the home screen. 0 = dock sits at the very bottom. Tiles shrink if
         the dock, its title and this many rows would not otherwise fit the screen height. -->
    <integer name="rows_below_dock">0</integer>

    <!-- The focused dock app's name in large type above the dock. false keeps only the glow, which leaves room
         for bigger tiles when rows_below_dock is 2 or 3. -->
    <bool name="dock_title">true</bool>

    <!-- Tiles per row in the grid; the dock always has this many slots. Tiles are 180dp wide at 4 columns and
         shrink to fit from 5 up (about 144dp at 5, 117dp at 6 on a 1080p TV). -->
    <integer name="columns">4</integer>

    <!-- Basic motion is on; advanced effects are opt-in in the launcher's own Settings screen. -->
    <bool name="animations">true</bool>
    <bool name="advanced_effects">false</bool>

    <!-- Optional Default-home tile; keep this key for existing themes and tile-ordering work.
         Off by default because the chooser is also available from launcher settings. -->
    <bool name="show_home_settings_shortcut">false</bool>

    <!-- Installed launchable apps, including ordinary Android apps. Also settable in config.json. -->
    <bool name="app_library">false</bool>
    <!-- Every app tile is its icon on a card tinted from that icon, name only under the focused tile,
         instead of each app's own banner. Off by default; a theme can set "uniform_tiles": true. -->
    <bool name="uniform_tiles">false</bool>
    <!-- Optional direct Home picker in the app library: OK toggles the checkmark, checked apps first.
         Off by default; a theme can set "app_library_selection": true (also needs app_library). -->
    <bool name="app_library_selection">false</bool>
    <!-- OK opens every app in the library, not only the apps on Home: for a library that holds the apps a theme
         keeps off Home with hidden_apps. Hold OK still offers Add to Home. app_library_selection wins when both are
         on. Off by default; a theme can set "library_ok_opens": true (also needs app_library). -->
    <bool name="library_ok_opens">false</bool>

    <!-- Apps pre-seeded into the App library's "added" set at startup (config.xml library_apps, or a theme's
         config.json). They show on Home as if the owner had added them in the App library UI, and stay
         removable there (a removed one stays hidden). For sets where almost no app declares a leanback entry
         (many China-market TVs, e.g. Coocaa 8R145), a fresh Home with app_library on would otherwise be
         nearly empty. Empty (off) by default, so existing setups change nothing. -->
    <string-array name="library_apps" translatable="false">
    </string-array>

    <!-- Module cards: an app that declares a card (docs/specs/card.md) can stand in for its tile with its own
         label, caption and glow colour, once you answer Show on the prompt. false: never look for cards or ask. -->
    <bool name="module_cards">true</bool>

    <!-- Reduced motion: for TVs whose GPU cannot keep up (MediaTek MT5895 on Android 10 is the known case).
         true keeps the GPU drawing path but calms the movement and draws far fewer frames: the highlight
         slides with no bounce and settles within 5 frames, every animation lasts 90 ms or less, names, top
         shelf, glow and highlight appear instead of fading, and there is no tile entrance. Set it
         here or with "reduced_motion": true in a theme's config.json; false keeps the normal motion. -->
    <bool name="reduced_motion">false</bool>

    <!-- The glass highlight springs past the tile it moves to and the focused tile zooms past its size
         before settling. false: both go straight there, with no bounce, while scrolling stays smooth
         (reduced_motion also removes the overshoot, but scrolls in one jump). Can also be set with
         "focus_overshoot" in a theme's config.json. -->
    <bool name="focus_overshoot">true</bool>

    <!-- One line under the clock: CPU, free memory and free storage. Off by default; a theme can set
         "show_stats": true. Nothing is read, and the clock does not move, while this is false. -->
    <bool name="show_stats">false</bool>

    <!-- Time-of-day backdrop behind everything: a dark gradient that follows the clock, with a warm
         horizon glow around sunrise and sunset. 0 keeps the plain background (the default); 1 to 100
         sets its opacity. Around 60 reads clearly without hiding a wallpaper. Can also be set with
         "sky_intensity": 60 in a theme's config.json. -->
    <integer name="sky_intensity">0</integer>
    <!-- Where the TV is, in decimal degrees, so the sky's sunrise and sunset glows follow the real sun
         (computed on the TV, no network). Empty: a fixed temperate day, sunset glow around 19:00.
         Vilnius: 54.69 and 25.28. -->
    <string name="latitude" translatable="false"></string>
    <string name="longitude" translatable="false"></string>

    <!-- Cinematic top shelf: the focused dock app's artwork, softened, fills the top of the screen in its
         colour; the shelf gets a larger name, a "Last opened" line (from the apps Home opened) and dock position
         dots, the focus glow takes the app's colour and the dock band turns translucent. false keeps the plain
         shelf. Can also be set with "cinematic_home": true in a theme's config.json. -->
    <bool name="cinematic_home">false</bool>
    <!-- With cinematic_home, false leaves out the dock position dots under the app's name, for a quieter shelf. Can
         also be set with "cinematic_dots": false in a theme's config.json. -->
    <bool name="cinematic_dots">true</bool>
    <!-- With cinematic_home, true keeps the focus highlight white on the dock instead of the focused app's colour,
         for wallpapers and banners that clash with it; app_glow still colours every tile. Can also be set with
         "cinematic_white_focus": true in a theme's config.json. -->
    <bool name="cinematic_white_focus">false</bool>
    <!-- With cinematic_home, how much of a wallpaper the shelf covers: cinematic_scrim is the strength of the dark
         scrim that keeps the name readable (0 to 100 percent, 100 as before) and cinematic_art the opacity of the
         app's softened artwork (0 to 100, 50 as before; 0 leaves the wallpaper uncovered). Lower values let a
         theme's wallpaper show through. A theme can set "cinematic_scrim" and "cinematic_art". -->
    <integer name="cinematic_scrim">100</integer>
    <integer name="cinematic_art">50</integer>

    <!-- The glow behind the dock in the focused app's colour (red for YouTube, blue for Prime Video). false keeps
         only background_color or the wallpaper behind everything. Can also be set with "ambient_glow": false in a
         theme's config.json. -->
    <bool name="ambient_glow">true</bool>
    <!-- The focus highlight glows in the focused app's colour on every tile, as the cinematic shelf does for the
         dock, without cinematic_home. Can also be set with "app_glow": true in a theme's config.json. -->
    <bool name="app_glow">false</bool>
    <!-- The rows fade out as they scroll up under the clock, instead of being cut off at a hard line (TopFade).
         The grid then draws into a hardware layer, about 6 MB of graphics memory at 1080p, so it is off by default.
         Can also be set with "fade_rows": true in a theme's config.json. -->
    <bool name="fade_rows">false</bool>
    <!-- Minutes Home may sit untouched before it shows the clock screensaver (ClockActivity); 0 turns it off.
         Unlike the system screensaver this never starts over live TV or an app, which matters on TVs whose
         Live TV window does not keep the screen on (CVTE): there the system screensaver would start in the
         middle of a programme. Can also be set with "home_idle_clock_minutes": 10 in a theme's config.json. -->
    <integer name="home_idle_clock_minutes">0</integer>
    <!-- The clock screensaver (Home idle clock and the system screensaver) over Home's wallpaper instead of black with
         a coloured glow. The clock still moves every minute. Can also be set with "clock_wallpaper" in a theme. -->
    <bool name="clock_wallpaper">false</bool>
    <!-- How dark that wallpaper is behind the clock, 0 to 90 %. Can also be set with "clock_wallpaper_dim". -->
    <integer name="clock_wallpaper_dim">50</integer>
    <!-- The clock screensaver's slow coloured glow behind the clock. false leaves the clock and date alone on plain black
         (OLED panels); they still move every minute. Ignored while clock_wallpaper shows a picture. Can also be set
         with "clock_glow" in a theme. -->
    <bool name="clock_glow">true</bool>
    <!-- Shape of the glow behind the focused app, in its colour: radial (a soft glow, the default) or horizon (the
         colour washes down from the top edge and fades to black, brightest along the top). The cinematic shelf
         keeps its own glow. Can also be set with "glow_style": "horizon" in a theme's config.json. -->
    <string name="glow_style" translatable="false">radial</string>
    <!-- The focus highlight's look: glass (the default: a translucent slab with a bright top sheen, a crisp rim and a
         faint outer glow), rim (the crisp rim alone, no sheen, fill or glow, for a quiet focus over a wallpaper) or
         halo (the rim with a lighter outer glow). Can also be set with "glass_style": "rim" in a theme's config.json. -->
    <string name="glass_style" translatable="false">glass</string>

    <!-- Tiles drawn from the app's icon and name instead of its banner (for banners that crop badly). -->
    <string-array name="icon_tiles" translatable="false">
    </string-array>
</resources>
