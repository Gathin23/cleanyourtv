<?xml version="1.0" encoding="utf-8"?>
<!-- The UI fonts, looked up through these strings so a locale can swap in a system family: the terminal
     theme wants a monospace face everywhere, and Outfit has no glyphs for most Vietnamese accented letters,
     so values-vi points them at the system sans-serif instead (#833). -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:ignore="ReferenceType">
    <string name="font_body" translatable="false">monospace</string>
    <string name="font_regular" translatable="false">monospace</string>
    <string name="font_light" translatable="false">monospace</string>
    <string name="font_extralight" translatable="false">monospace</string>
    <string name="font_medium" translatable="false">monospace</string>
</resources>
