<?xml version="1.0" encoding="utf-8"?>
<!-- Chinese text sits low in the line: without font padding and with the text dropped 2dp it lines up with
     the icon (drawable-zh/ic_apps_pill nudges that down too). -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="84dp">
    <TextView android:id="@+id/btnLibrary" style="@style/TopButton"
        android:layout_gravity="center" android:text="@string/app_library"
        android:drawableStart="@drawable/ic_apps_pill"
        android:includeFontPadding="false"
        android:paddingBottom="2dp" />
</FrameLayout>
