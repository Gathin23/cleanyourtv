<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF0B132B"
    android:orientation="horizontal"
    android:paddingStart="40dp"
    android:paddingEnd="40dp">

    <!-- Left Anchor (35% width, centered vertically) -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.36"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp">

        <ImageView
            android:layout_width="88dp"
            android:layout_height="88dp"
            android:background="@drawable/bg_chillhub_badge"
            android:src="@drawable/ic_tune"
            android:tint="#FFFFFFFF"
            android:padding="20dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="22dp"
            android:text="@string/launcher_settings"
            android:textColor="#FFFFFFFF"
            android:textSize="26sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="CleanYourTV · v1.5"
            android:textColor="#80FFFFFF"
            android:textSize="14sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="OTH-100 · 1 GB RAM Edition"
            android:textColor="#50FFFFFF"
            android:textSize="12sp" />
    </LinearLayout>

    <!-- Right Menu Deck (64% width, scrollable) -->
    <ScrollView
        android:id="@+id/rightScroll"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="0.64"
        android:fillViewport="true"
        android:paddingTop="36dp"
        android:paddingBottom="36dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp">

            <!-- Section 1: Customizations -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CUSTOMIZATIONS"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:fontFamily="@string/font_medium"
                android:layout_marginBottom="10dp" />

            <!-- Row 1: Apps per row -->
            <LinearLayout
                android:id="@+id/rowColumns"
                style="@style/ChillHubRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_apps"
                    android:tint="@color/color_chillhub_icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:duplicateParentState="true"
                    android:text="Apps per Row"
                    android:textColor="@color/color_chillhub_text"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/txtColumnsVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="5"
                    android:textColor="@color/color_chillhub_subtext"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Row 2: Dock opacity -->
            <LinearLayout
                android:id="@+id/rowDockOpacity"
                style="@style/ChillHubRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/color_chillhub_icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:duplicateParentState="true"
                    android:text="Dock Band Opacity"
                    android:textColor="@color/color_chillhub_text"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/txtDockOpacityVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="100%"
                    android:textColor="@color/color_chillhub_subtext"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Row 3: Rows below dock -->
            <LinearLayout
                android:id="@+id/rowRowsBelow"
                style="@style/ChillHubRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_swap_vert"
                    android:tint="@color/color_chillhub_icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:duplicateParentState="true"
                    android:text="Rows Below Dock"
                    android:textColor="@color/color_chillhub_text"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/txtRowsBelowVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="0"
                    android:textColor="@color/color_chillhub_subtext"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Row 4: Clock format -->
            <LinearLayout
                android:id="@+id/rowClockFormat"
                style="@style/ChillHubRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_picture"
                    android:tint="@color/color_chillhub_icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:duplicateParentState="true"
                    android:text="Time Clock"
                    android:textColor="@color/color_chillhub_text"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/txtClockFormatVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="System"
                    android:textColor="@color/color_chillhub_subtext"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Row 5: Wallpaper -->
            <LinearLayout
                android:id="@+id/rowWallpaper"
                style="@style/ChillHubRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_picture"
                    android:tint="@color/color_chillhub_icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:duplicateParentState="true"
                    android:text="Background Wallpaper"
                    android:textColor="@color/color_chillhub_text"
                    android:textSize="15sp" />
                <TextView
                    android:id="@+id/txtWallpaperVal"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="In use"
                    android:textColor="@color/color_chillhub_subtext"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Row 6: Pick custom wallpaper -->
            <LinearLayout
                android:id="@+id/rowPickWallpaper"
                style="@style/ChillHubRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_input"
                    android:tint="@color/color_chillhub_icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:duplicateParentState="true"
                    android:text="Choose from Gallery / File Manager…"
                    android:textColor="@color/color_chillhub_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Section 2: Management -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MANAGEMENT"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:fontFamily="@string/font_medium"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp" />

            <!-- Row 7: Kill apps / Free RAM -->
            <LinearLayout
                android:id="@+id/rowKillApps"
                style="@style/ChillHubRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_clean"
                    android:tint="@color/color_chillhub_icon" />
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:duplicateParentState="true"
                    android:orientation="vertical">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:text="Close All Background Apps"
                        android:textColor="@color/color_chillhub_text"
                        android:textSize="15sp" />
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:duplicateParentState="true"
                        android:text="Reclaim free RAM for smooth TV playback"
                        android:textColor="@color/color_chillhub_subtext"
                        android:textSize="11sp" />
                </LinearLayout>
                <TextView
                    android:id="@+id/txtRamFreeBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="Free RAM"
                    android:textColor="#FF2DD4BF"
                    android:textSize="13sp" />
            </LinearLayout>

            <!-- Row 8: App Management / Reorder -->
            <LinearLayout
                android:id="@+id/rowAppReorder"
                style="@style/ChillHubRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_swap_vert"
                    android:tint="@color/color_chillhub_icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:duplicateParentState="true"
                    android:text="App Management &amp; Reorder"
                    android:textColor="@color/color_chillhub_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Row 9: App Library -->
            <LinearLayout
                android:id="@+id/rowAppLibrary"
                style="@style/ChillHubRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_apps"
                    android:tint="@color/color_chillhub_icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:duplicateParentState="true"
                    android:text="@string/app_library"
                    android:textColor="@color/color_chillhub_text"
                    android:textSize="15sp" />
            </LinearLayout>

            <!-- Section 3: System -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SYSTEM"
                android:textColor="#80FFFFFF"
                android:textSize="12sp"
                android:letterSpacing="0.15"
                android:fontFamily="@string/font_medium"
                android:layout_marginTop="20dp"
                android:layout_marginBottom="10dp" />

            <!-- Row 10: Android System Settings -->
            <LinearLayout
                android:id="@+id/rowTvSettings"
                style="@style/ChillHubRow">
                <ImageView
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:duplicateParentState="true"
                    android:src="@drawable/ic_settings"
                    android:tint="@color/color_chillhub_icon" />
                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="16dp"
                    android:duplicateParentState="true"
                    android:text="Android TV System Settings"
                    android:textColor="@color/color_chillhub_text"
                    android:textSize="15sp" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:duplicateParentState="true"
                    android:text="System"
                    android:textColor="@color/color_chillhub_subtext"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
