<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/sportsPanel"
    android:layout_width="480dp"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:padding="12dp"
    android:elevation="14dp">

    <!-- Header bar -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="4dp"
        android:paddingEnd="4dp"
        android:paddingBottom="8dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/sports_recommendations"
            android:textColor="#B3FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.18"
            android:textAllCaps="true" />

        <TextView
            android:id="@+id/btnRefreshSports"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:background="@drawable/input_row_bg"
            android:focusable="true"
            android:clickable="true"
            android:text="REFRESH"
            android:textColor="@drawable/pill_text"
            android:textSize="10sp"
            android:fontFamily="@string/font_medium"
            android:letterSpacing="0.1" />
    </LinearLayout>

    <!-- Filter chips row -->
    <LinearLayout
        android:id="@+id/sportsFilterBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingTop="2dp"
        android:paddingBottom="10dp">

        <TextView
            android:id="@+id/filterAll"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="5dp"
            android:background="@drawable/input_row_bg"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/sports_filter_all"
            android:textColor="@drawable/pill_text"
            android:textSize="11sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:id="@+id/filterSoccer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="5dp"
            android:background="@drawable/input_row_bg"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/sports_filter_soccer"
            android:textColor="@drawable/pill_text"
            android:textSize="11sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:id="@+id/filterTennis"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="5dp"
            android:background="@drawable/input_row_bg"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/sports_filter_tennis"
            android:textColor="@drawable/pill_text"
            android:textSize="11sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:id="@+id/filterF1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="6dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="5dp"
            android:background="@drawable/input_row_bg"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/sports_filter_f1"
            android:textColor="@drawable/pill_text"
            android:textSize="11sp"
            android:fontFamily="@string/font_medium" />

        <TextView
            android:id="@+id/filterCricket"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="5dp"
            android:background="@drawable/input_row_bg"
            android:focusable="true"
            android:clickable="true"
            android:text="@string/sports_filter_cricket"
            android:textColor="@drawable/pill_text"
            android:textSize="11sp"
            android:fontFamily="@string/font_medium" />
    </LinearLayout>

    <!-- Empty or loading status -->
    <TextView
        android:id="@+id/sportsStatusMsg"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:gravity="center"
        android:text="@string/sports_loading"
        android:textColor="#99FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@string/font_regular"
        android:visibility="gone" />

    <!-- Fixtures scroll list -->
    <ScrollView
        android:id="@+id/sportsScroll"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/fixturesContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>
</LinearLayout>
