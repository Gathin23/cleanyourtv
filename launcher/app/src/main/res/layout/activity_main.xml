<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <!-- Time-of-day backdrop, drawn once a minute (config.xml sky_intensity; 0 keeps it hidden). -->
    <com.norma.tvlauncher.SkyView
        android:id="@+id/sky"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:importantForAccessibility="no" />

    <!-- Cinematic top shelf (cinematic_home): the focused dock app's artwork, a few pixels across and
         stretched over the screen, which softens it like a blur without the cost of one. Hidden otherwise. -->
    <ImageView
        android:id="@+id/heroArt"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Ambient glow in the colour of the focused dock app. -->
    <View
        android:id="@+id/ambient"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:alpha="0" />

    <!-- Full-screen dynamic wallpapers for focused dock apps (cross-fading) -->
    <ImageView
        android:id="@+id/dockWallpaperA"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <ImageView
        android:id="@+id/dockWallpaperB"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Apple TV-style gradient scrim over wallpaper for legibility -->
    <View
        android:id="@+id/wallpaperScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/wallpaper_scrim"
        android:alpha="0"
        android:importantForAccessibility="no" />

    <!-- Darkening scrim for edit mode (reorder apps or remove dock app) -->
    <View
        android:id="@+id/editModeScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#B8000000"
        android:alpha="0"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <!-- Race-weekend panel (a theme's race_calendar, see RaceWeekend): in the free space under the clock,
         shown only from shortly before a weekend's first session until the race is over. Updated once a
         minute with the clock, never animated. -->
    <LinearLayout
        android:id="@+id/racePanel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|left"
        android:layout_marginStart="60dp"
        android:layout_marginTop="158dp"
        android:orientation="vertical"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <!-- A short kerb-red bar, the panel's one accent. -->
            <View
                android:layout_width="3dp"
                android:layout_height="13dp"
                android:layout_marginEnd="10dp"
                android:background="@drawable/race_bar" />

            <TextView
                android:id="@+id/raceKicker"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:singleLine="true"
                android:textColor="#B3FFFFFF"
                android:textSize="12sp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.22"
                android:textAllCaps="true" />
        </LinearLayout>

        <TextView
            android:id="@+id/raceHeadline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:singleLine="true"
            android:textColor="#FFFFFFFF"
            android:textSize="34sp"
            android:fontFamily="@font/inter_light"
            android:letterSpacing="-0.01"
            android:includeFontPadding="false" />

        <TextView
            android:id="@+id/raceSessions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:singleLine="true"
            android:textColor="#99FFFFFF"
            android:textSize="12sp"
            android:fontFamily="@font/inter_medium"
            android:letterSpacing="0.12" />
    </LinearLayout>

    <!-- Cinematic top shelf: darkens the edge behind the shelf and the lower half, so the text and the
         dock stay readable over the artwork. -->
    <View
        android:id="@+id/heroScrim"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="26dp"
        android:clipChildren="false"
        android:clipToPadding="false">

        <!-- First layer: PS5-style top bar with icon-only buttons beside clock & date -->
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipChildren="false"
            android:clipToPadding="false">

            <TextView
                android:id="@+id/greeting"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/shamsiDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <TextView
                android:id="@+id/stats"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone" />

            <View
                android:id="@+id/leftBlock"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone" />

            <!-- Hidden tabs preserved for legacy bindings -->
            <LinearLayout
                android:id="@+id/topTabs"
                android:layout_width="0dp"
                android:layout_height="0dp"
                android:visibility="gone">
                <TextView android:id="@+id/tabHome" android:layout_width="0dp" android:layout_height="0dp" />
                <TextView android:id="@+id/tabApp" android:layout_width="0dp" android:layout_height="0dp" />
            </LinearLayout>

            <!-- First layer left side: Date and Time -->
            <LinearLayout
                android:id="@+id/dateTimeBlock"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:orientation="vertical"
                android:gravity="start">

                <TextClock
                    android:id="@+id/clock"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:format12Hour="h:mm a"
                    android:format24Hour="HH:mm"
                    android:textColor="#FFFFFFFF"
                    android:textSize="20sp"
                    android:fontFamily="@font/inter_medium"
                    android:letterSpacing="0.02"
                    android:includeFontPadding="false" />

                <TextClock
                    android:id="@+id/date"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:format12Hour="@string/date_format_home"
                    android:format24Hour="@string/date_format_home"
                    android:textColor="#99FFFFFF"
                    android:textSize="11sp"
                    android:fontFamily="@font/inter_regular"
                    android:letterSpacing="0.10"
                    android:textAllCaps="true" />
            </LinearLayout>

            <!-- First layer right side: Unified Action Cluster (Weather, Inputs, Wifi, Settings) -->
            <LinearLayout
                android:id="@+id/topButtons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center_vertical"
                android:clipChildren="false"
                android:clipToPadding="false"
                android:descendantFocusability="afterDescendants"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/weatherPill"
                    style="@style/TopButtonBase"
                    android:layout_width="wrap_content"
                    android:layout_height="42dp"
                    android:layout_marginStart="0dp"
                    android:paddingStart="14dp"
                    android:paddingEnd="16dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:focusable="true"
                    android:clickable="true"
                    android:nextFocusLeft="@+id/weatherPill"
                    android:nextFocusRight="@+id/btnInputs"
                    android:nextFocusDown="@+id/grid"
                    android:contentDescription="@string/weather">

                    <ImageView
                        android:id="@+id/weatherIcon"
                        android:layout_width="20dp"
                        android:layout_height="20dp"
                        android:src="@drawable/ic_weather_partly_cloudy"
                        android:tint="@drawable/pill_text"
                        android:contentDescription="@string/weather"
                        android:duplicateParentState="true"
                        android:importantForAccessibility="no" />

                    <TextView
                        android:id="@+id/weatherTemp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@drawable/pill_text"
                        android:textSize="15sp"
                        android:duplicateParentState="true"
                        android:text="28°C" />

                    <TextView
                        android:id="@+id/weatherDot"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="6dp"
                        android:layout_marginEnd="6dp"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@drawable/pill_text"
                        android:alpha="0.5"
                        android:textSize="12sp"
                        android:duplicateParentState="true"
                        android:text="•" />

                    <TextView
                        android:id="@+id/weatherCity"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:fontFamily="@font/inter_medium"
                        android:textColor="@drawable/pill_text"
                        android:textSize="15sp"
                        android:duplicateParentState="true"
                        android:text="Bekasi" />
                </LinearLayout>

                <TextView
                    android:id="@+id/btnInputs"
                    style="@style/TopButtonIcon"
                    android:layout_marginStart="10dp"
                    android:contentDescription="@string/inputs"
                    android:drawableStart="@drawable/ic_input"
                    android:nextFocusLeft="@+id/weatherPill"
                    android:nextFocusRight="@+id/btnWifi"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnWifi"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/wifi"
                    android:drawableStart="@drawable/ic_wifi"
                    android:layout_marginStart="10dp"
                    android:nextFocusLeft="@+id/btnInputs"
                    android:nextFocusRight="@+id/btnSettings"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnReorder"
                    style="@style/TopButtonIcon"
                    android:visibility="gone"
                    android:contentDescription="@string/reorder"
                    android:drawableStart="@drawable/ic_swap_vert"
                    android:layout_marginStart="10dp"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnLibraryTop"
                    style="@style/TopButtonIcon"
                    android:visibility="gone"
                    android:contentDescription="@string/app_library"
                    android:drawableStart="@drawable/ic_apps"
                    android:layout_marginStart="10dp"
                    android:nextFocusDown="@+id/grid" />

                <TextView
                    android:id="@+id/btnSettings"
                    style="@style/TopButtonIcon"
                    android:contentDescription="@string/settings"
                    android:drawableStart="@drawable/ic_settings"
                    android:layout_marginStart="10dp"
                    android:nextFocusLeft="@+id/btnWifi"
                    android:nextFocusRight="@+id/btnSettings"
                    android:nextFocusDown="@+id/grid" />
            </LinearLayout>
        </RelativeLayout>

        <!-- The wrapper clips at the grid's edge; the grid itself must not clip so scaled tiles can overflow their cells. -->
        <FrameLayout
            android:id="@+id/contentFrame"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="10dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/grid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_gravity="start|top"
                android:paddingTop="10dp"
                android:paddingBottom="40dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:descendantFocusability="afterDescendants"
                android:focusable="true">
                <requestFocus />
            </androidx.recyclerview.widget.RecyclerView>

            <!-- App page: 5-column grid for ALL apps -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/appsGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="20dp"
                android:paddingBottom="48dp"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:visibility="gone"
                android:descendantFocusability="afterDescendants" />
        </FrameLayout>
    </LinearLayout>

    <!-- Title app on the bottom left with larger font size, status dots on top -->
    <LinearLayout
        android:id="@+id/hero"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|start"
        android:layout_marginStart="56dp"
        android:layout_marginBottom="68dp"
        android:orientation="vertical"
        android:alpha="0">

        <!-- Status dots on top the title app -->
        <LinearLayout
            android:id="@+id/heroDots"
            android:layout_width="wrap_content"
            android:layout_height="6dp"
            android:layout_marginBottom="16dp"
            android:orientation="horizontal" />

        <!-- Title app with larger font size -->
        <TextView
            android:id="@+id/heroName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF"
            android:textSize="54sp"
            android:fontFamily="@font/inter_light"
            android:letterSpacing="-0.02"
            android:includeFontPadding="false"
            android:singleLine="true" />

        <TextView
            android:id="@+id/heroMeta"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

    <!-- App statistics on the bottom right (weekly screen time & storage) -->
    <LinearLayout
        android:id="@+id/appStats"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_marginEnd="56dp"
        android:layout_marginBottom="72dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingStart="24dp"
        android:paddingEnd="24dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="@drawable/app_stats_bg"
        android:alpha="0">

        <!-- Stat 1: Weekly Screen Time -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Weekly Screen Time"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/statWeeklyTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.01"
                android:text="0 hr" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="1dp"
            android:layout_height="24dp"
            android:layout_marginStart="20dp"
            android:layout_marginEnd="20dp"
            android:background="#22FFFFFF" />

        <!-- Stat 2: Storage Usage -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="start">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Storage Usage"
                android:textColor="#88FFFFFF"
                android:textSize="10sp"
                android:fontFamily="@font/inter_medium"
                android:letterSpacing="0.04" />

            <TextView
                android:id="@+id/statStorage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="#FFFFFFFF"
                android:textSize="16sp"
                android:fontFamily="@font/inter_semibold"
                android:letterSpacing="0.01"
                android:text="0 MB" />
        </LinearLayout>
    </LinearLayout>

    <!-- All Apps Modal Popup Overlay with Blurred Backdrop -->
    <FrameLayout
        android:id="@+id/allAppsModalOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="false"
        android:elevation="35dp">

        <!-- Blurred Background ImageView -->
        <ImageView
            android:id="@+id/allAppsBlurredBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <!-- Frosted Scrim Dim Overlay -->
        <View
            android:id="@+id/allAppsBackdropScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B8050508"
            android:importantForAccessibility="no" />

        <!-- Centered Modal Glass Panel (5 x 5 layout) -->
        <LinearLayout
            android:id="@+id/allAppsModalPanel"
            android:layout_width="820dp"
            android:layout_height="450dp"
            android:layout_gravity="center"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="20dp"
            android:elevation="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Modal Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_apps"
                        android:layout_marginEnd="10dp"
                        android:tint="#FFFFFFFF" />

                    <TextView
                        android:id="@+id/allAppsModalTitle"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/all_apps"
                        android:textColor="#FFFFFFFF"
                        android:textSize="22sp"
                        android:fontFamily="@font/inter_semibold" />
                </LinearLayout>

                <TextView
                    android:id="@+id/allAppsCountBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_medium"
                    android:background="@drawable/pill_badge_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </RelativeLayout>

            <!-- 5-column small icon grid -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/allAppsModalGrid"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:focusable="true"
                android:descendantFocusability="afterDescendants" />
        </LinearLayout>
    </FrameLayout>

    <!-- Internal Storage File Browser Modal Overlay -->
    <FrameLayout
        android:id="@+id/fileBrowserOverlay"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:clickable="true"
        android:focusable="false"
        android:elevation="36dp">

        <!-- Blurred Background ImageView -->
        <ImageView
            android:id="@+id/fileBrowserBlurredBackdrop"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:importantForAccessibility="no" />

        <!-- Frosted Scrim Dim Overlay -->
        <View
            android:id="@+id/fileBrowserBackdropScrim"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#B8050508"
            android:importantForAccessibility="no" />

        <!-- Centered Modal Glass Panel -->
        <LinearLayout
            android:id="@+id/fileBrowserModalPanel"
            android:layout_width="820dp"
            android:layout_height="480dp"
            android:layout_gravity="center"
            android:background="@drawable/glass_panel"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp"
            android:paddingBottom="16dp"
            android:elevation="16dp"
            android:clipChildren="false"
            android:clipToPadding="false">

            <!-- Modal Header -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="12dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true">

                    <ImageView
                        android:layout_width="22dp"
                        android:layout_height="22dp"
                        android:src="@drawable/ic_folder"
                        android:layout_marginEnd="10dp"
                        android:tint="#FFFFFFFF" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/fileBrowserTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Choose Wallpaper"
                            android:textColor="#FFFFFFFF"
                            android:textSize="20sp"
                            android:fontFamily="@font/inter_semibold" />

                        <TextView
                            android:id="@+id/fileBrowserPath"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="/sdcard"
                            android:textColor="#88FFFFFF"
                            android:textSize="12sp"
                            android:fontFamily="@font/inter_regular"
                            android:singleLine="true"
                            android:ellipsize="middle" />
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:id="@+id/fileBrowserItemCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="#CCFFFFFF"
                    android:textSize="12sp"
                    android:fontFamily="@font/inter_medium"
                    android:background="@drawable/pill_badge_bg"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp" />
            </RelativeLayout>

            <!-- File List RecyclerView -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/fileBrowserList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:clipToPadding="false"
                android:clipChildren="false"
                android:overScrollMode="never"
                android:scrollbars="none"
                android:focusable="true"
                android:descendantFocusability="afterDescendants" />

            <!-- Empty Notice -->
            <TextView
                android:id="@+id/fileBrowserEmptyText"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="No images or subfolders found"
                android:textColor="#66FFFFFF"
                android:textSize="14sp"
                android:visibility="gone" />

            <!-- Footer Hint -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:gravity="center"
                android:text="Select an image (.jpg, .png, .webp) \u00B7 BACK to go up or exit"
                android:textColor="#55FFFFFF"
                android:textSize="11sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- The single floating glass highlight that springs between tiles. -->
    <com.norma.tvlauncher.GlassView
        android:id="@+id/glass"
        android:layout_width="10dp"
        android:layout_height="10dp"
        android:alpha="0"
        android:importantForAccessibility="no" />
</FrameLayout>
