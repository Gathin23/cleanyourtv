<?xml version="1.0" encoding="utf-8"?>
<!-- The module card prompt: who is asking (app label, package, signing key) and two buttons.
     Keep hidden is focused first; Back means Keep hidden too. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/glass_panel"
    android:paddingStart="26dp"
    android:paddingEnd="26dp"
    android:paddingTop="22dp"
    android:paddingBottom="20dp"
    android:elevation="12dp">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:ellipsize="end"
        android:textColor="#FFFFFFFF"
        android:textSize="22sp"
        android:fontFamily="@string/font_medium"
        android:letterSpacing="-0.01" />

    <TextView
        android:id="@+id/body"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="#D9FFFFFF"
        android:textSize="15sp"
        android:lineSpacingExtra="3sp"
        android:fontFamily="@string/font_body" />

    <TextView
        android:id="@+id/names"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textColor="#D9FFFFFF"
        android:textSize="15sp"
        android:lineSpacingExtra="3sp"
        android:fontFamily="@string/font_body" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/card_prompt_hint"
        android:textColor="#99FFFFFF"
        android:textSize="13sp"
        android:fontFamily="@string/font_body" />

    <TextView
        android:id="@+id/identity"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:maxLines="2"
        android:textColor="#80FFFFFF"
        android:textSize="12sp"
        android:letterSpacing="0.03"
        android:fontFamily="@string/font_body" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="18dp"
        android:orientation="horizontal"
        android:gravity="end">

        <TextView
            android:id="@+id/btnKeep"
            style="@style/TopButton"
            android:text="@string/card_keep_hidden"
            android:nextFocusUp="@+id/btnKeep"
            android:nextFocusDown="@+id/btnKeep"
            android:nextFocusLeft="@+id/btnKeep"
            android:nextFocusRight="@+id/btnShow" />

        <TextView
            android:id="@+id/btnShow"
            style="@style/TopButton"
            android:text="@string/card_show"
            android:nextFocusUp="@+id/btnShow"
            android:nextFocusDown="@+id/btnShow"
            android:nextFocusLeft="@+id/btnKeep"
            android:nextFocusRight="@+id/btnShow" />
    </LinearLayout>
</LinearLayout>
